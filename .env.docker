POSTGRES_PASSWORD=cbom_pass_2024
DATABASE_URL=postgresql+asyncpg://cbom_user:cbom_pass_2024@db:5432/cbom_db

# IMPORTANT: Replace with a cryptographically random string in production
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-secret-key-replace-in-production
